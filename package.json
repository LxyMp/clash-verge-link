{
  "name": "clash-verge-link",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite build --watch",
    "test": "tsx --test tests/*.test.ts",
    "build": "vue-tsc --noEmit && vite build",
    "lint:addon": "yarn build && web-ext lint --source-dir dist-firefox --no-config-discovery",
    "firefox": "yarn build && web-ext run --source-dir dist-firefox",
    "package:addon": "yarn build && web-ext build --source-dir dist-firefox --artifacts-dir web-ext-artifacts --overwrite-dest --no-config-discovery",
    "package:source": "node scripts/package-source.mjs",
    "icons": "node scripts/render-icons.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-vue-next": "^0.460.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/firefox-webext-browser": "^143.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "sass": "^1.83.0",
    "tsx": "^4.23.1",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0",
    "web-ext": "^10.5.0"
  }
}
