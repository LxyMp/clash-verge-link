{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "default_locale": "zh_CN",
  "description": "__MSG_appDesc__",
  "browser_specific_settings": {
    "gecko": {
      "id": "clash-verge-link@dx",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["proxy", "storage", "contextMenus"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://localhost/*",
    "https://localhost/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  }
}
